class Solution {
    public int[] maxDepthAfterSplit(String seq) {
        char[] chars = seq.toCharArray();
        int n = chars.length;
        int[] ans = new int[n];
        int depth = 0;
        for (int i = 0; i < n; i++) {
            if (chars[i] == '(') {
                ans[i] = depth & 1; 
                depth++;
            } else {
                depth--;
                ans[i] = depth & 1;
            }
        }
        return ans;
    }
}
