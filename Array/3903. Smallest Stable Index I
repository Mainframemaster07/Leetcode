class Solution {
  public int firstStableIndex(int[] nums, int k) {
        int len = nums.length;
        int[] prefixMax = new int[len];
        int[] suffixMin = new int[len];
        int max = nums[0];
        int min = nums[len - 1];
        for (int i = 0; i < len; i++) {
            max = Math.max(max, nums[i]);
            prefixMax[i] = max;
        }
        for (int i = len - 1; i >= 0; i--) {
            min = Math.min(min, nums[i]);
            suffixMin[i] = min;
        }
        for (int i = 0; i < len; i++) {
            if (prefixMax[i] - suffixMin[i] <= k) {
                return i;
            }
        }

        return -1;
    }
}
