class Solution {
    int m, n;
    char[][] grid;
    int[][][] memo;
    int maxBal;
    private boolean dfs(int i, int j, int bal) {
        if (i >= m || j >= n) return false;
        bal += (grid[i][j] == '(') ? 1 : -1;
        if (bal < 0) return false; 
        if (bal > maxBal) return false; 
        if (i == m - 1 && j == n - 1) {
            return bal == 0;
        }
        if (memo[i][j][bal] != -1) return memo[i][j][bal] == 1;
        boolean ok = dfs(i + 1, j, bal) || dfs(i, j + 1, bal);
        memo[i][j][bal] = ok ? 1 : 0;
        return ok;
    }
    public boolean hasValidPath(char[][] grid) {
        this.grid = grid;
        m = grid.length;
        n = grid[0].length;
        if (grid[0][0] == ')') return false;
        if (grid[m - 1][n - 1] == '(') return false;
        if (((m + n) & 1) == 0) return false;
        maxBal = m + n; 
        memo = new int[m][n][maxBal + 1];
        for (int i = 0; i < m; i++)
            for (int j = 0; j < n; j++)
                Arrays.fill(memo[i][j], -1);
        return dfs(0, 0, 0);
    }
}
